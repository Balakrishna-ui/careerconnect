generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums are removed for SQLite compatibility. We use String defaults.
model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?
  mobile   String? @unique
  image    String?
  role     String  @default("USER") // Using String since enums aren't natively supported in SQLite the same way, or we can use Prisma Enums (Prisma handles enum emulation in SQLite partially, actually SQLite doesn't support enums natively. Let's use String default).
  premium  Boolean @default(false)

  mentorProfile Mentor?
  adminReviews  AdminReview[]
  auditLogs     AuditLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?
  bookings      Booking[]
  subscriptions Subscription[]
  invoices      Invoice[]
  tasks         JobSeekerTask[]
  documents     UserDocument[]
  conversations1 Conversation[] @relation("User1")
  conversations2 Conversation[] @relation("User2")
  messages      Message[]

  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  savedMentors  SavedMentor[]
  reviews       Review[]
  supportTickets SupportTicket[] @relation("TicketCreator")
  assignedTickets SupportTicket[] @relation("AssignedAdmin")
  supportMessages SupportMessage[]

  // Security & Fraud
  isMfaEnabled      Boolean      @default(false)
  mfaSecret         String?      
  riskScore         Int          @default(0)
  riskLevel         String       @default("LOW")
  fraudStatus       String       @default("CLEARED")
  failedLoginAttempts Int        @default(0)
  lockedUntil       DateTime?
  jwtVersion        Int          @default(0)
  loginHistory      LoginHistory[]
  devices           DeviceFingerprint[]
  securityEvents    SecurityEvent[]
  auditLogsTargeted AdminAuditLog[] @relation("TargetUser")
  // Job Seeker Profile Fields
  headline          String?
  bio               String?  @db.Text
  location          String?
  city              String?
  state             String?
  country           String?
  dob               DateTime?
  gender            String?
  roleCategory      String?
  coverImage        String?
  experienceYears   Int?
  industry          String?
  
  // Professional Information
  jobTitle          String?
  currentCompany    String?
  employmentType    String?
  careerLevel       String?
  expectedSalary    String?
  noticePeriod      String?
  employmentStatus  String?
  
  // Career Preferences
  targetJobTitle    String?
  preferredJobRoles String?
  preferredIndustries String?
  preferredLocations  String?
  workPreferences   String? // Remote / Hybrid / On-site
  expectedSalaryRange String?
  preferredEmploymentType String? // Full-time, Part-time, Contract, Internship
  openToRelocation  Boolean @default(false)
  careerGoals       String? @db.Text
  isFresher         Boolean @default(false)
  targetDomains     String?
  specializations   String?
  currentSalary     String?

  // Shared generic relations
  experiences       Experience[]
  educations        Education[]
  projects          Project[]
  certifications    Certification[]
  skills            Skill[]
  socialProfile     SocialProfile?

  accountStatus     String @default("ACTIVE") // ACTIVE, SUSPENDED
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String    @default("PREMIUM") // FREE, PRO, PREMIUM
  price        Int       @default(99)
  status       String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  billingCycle String    @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  autoRenew    Boolean   @default(true)
  startDate    DateTime  @default(now())
  endDate      DateTime?
  renewalDate  DateTime?
  invoices     Invoice[]
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
}

model Invoice {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  planName       String
  amount         Int
  paymentMethod  String       @default("Card ending in 4242")
  status         String       @default("PAID") // PAID, PENDING, FAILED, REFUNDED
  pdfUrl         String?

  @@index([userId])
  @@index([subscriptionId])
}

model Mentor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public Display
  name            String
  role            String?
  company         String?
  industry        String?
  experienceYears Int?
  rating          Float     @default(0.0)
  reviewsCount    Int       @default(0)
  price           Int       @default(0)
  image           String?
  coverImage      String?
  resumeUrl       String?
  companyTier     String    @default("Other")
  location        String?
  languages       String? // comma separated list
  remoteAvailable Boolean   @default(true)
  nextAvailable   DateTime?
  totalSessions   Int       @default(0)

  // Profile Completion & Verification
  profileCompleted  Boolean @default(false)
  completionScore   Int     @default(0) // 0 to 100
  applicationStatus String  @default("DRAFT") // DRAFT, PENDING, VERIFIED, REJECTED, MORE_INFO_REQUIRED

  // Insight Metrics
  profileViews      Int     @default(0)
  searchAppearances Int     @default(0)
  profileClicks     Int     @default(0)
  responseRate      Int     @default(100)
  earningsThisMonth Int     @default(0)
  vacationMode      Boolean @default(false)

  // Step 1: Personal Info
  gender   String?
  dob      DateTime?
  country  String?
  state    String?
  city     String?
  timezone String?

  // Step 2: Professional Info
  employmentType    String?
  careerLevel       String?
  currentCTC        String?
  noticePeriod      String?
  headline          String?
  profileVisibility String  @default("PRIVATE") // PUBLIC, PRIVATE

  // Step 4: About
  bio        String?
  highlights String?

  settings        MentorSettings?
  weeklySchedules WeeklySchedule[]
  blockedDates    BlockedDate[]
  bookings        Booking[]
  calendarSync    CalendarIntegration?

  skills         Skill[]
  sessionTypes   SessionType[]
  socialProfiles SocialProfile?
  documents      VerificationDocument[]
  adminReviews   AdminReview[]

  savedMentors SavedMentor[]
  reviews      Review[]
  supportTickets SupportTicket[]

  experiences Experience[]
  educations  Education[]
  projects       Project[]
  certifications Certification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationStatus, profileCompleted])
  @@index([industry])
  @@index([company])
  @@index([companyTier])
}

model Skill {
  id       String @id @default(cuid())
  mentorId String?
  mentor   Mentor? @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  category String // Technical, Non-Technical, Areas of Mentorship
}

model SessionType {
  id       String @id @default(cuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  title    String // e.g., Resume Review
  duration Int // minutes
  price    Int // 0 if Free Discovery

  @@index([mentorId])
}

model SocialProfile {
  id        String  @id @default(cuid())
  mentorId  String?  @unique
  mentor    Mentor?  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedin  String
  portfolio String?
  github    String?
  twitter   String?
  youtube   String?
  website   String?
  leetcode  String?
  codechef  String?
  hackerrank String?
  behance   String?
  dribbble  String?
}

model VerificationDocument {
  id         String   @id @default(cuid())
  mentorId   String
  mentor     Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  type       String // EMPLOYEE_ID, GOVT_ID, RESUME
  fileUrl    String
  status     String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  uploadedAt DateTime @default(now())
}

model AdminReview {
  id       String @id @default(cuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  adminId  String
  admin    User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  statusGiven String
  reason      String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())
}

// Existing Models retained to avoid breaking other functionality
model MentorSettings {
  id                   String   @id @default(cuid())
  mentorId             String   @unique
  mentor               Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessionDuration      Int      @default(60)
  bufferTime           Int      @default(15)
  maxSessionsPerDay    Int      @default(5)
  advanceBookingWindow Int      @default(30)
  noticePeriod         Int      @default(24)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model WeeklySchedule {
  id          String  @id @default(cuid())
  mentorId    String
  mentor      Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)

  @@unique([mentorId, dayOfWeek])
}

model BlockedDate {
  id       String   @id @default(cuid())
  mentorId String
  mentor   Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  date     DateTime
  reason   String?

  @@unique([mentorId, date])
}

model Booking {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId            String
  mentor              Mentor             @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  date                DateTime
  startTime           DateTime
  endTime             DateTime
  status              String             @default("PENDING")
  price               Int
  meetingLink         String?
  
  // Additional Details
  sessionTitle        String?            @default("1:1 Mentorship Session")
  goal                String?
  experience          String?
  message             String?            @db.Text
  resumeUrl           String?
  meetingInstructions String?            @db.Text

  // Relations
  payment             Payment?
  rescheduleReq       RescheduleRequest?
  cancellationReq     CancellationRequest?
  notifications       Notification[]
  sessionNotes        SessionNote?
  sessionSummary      SessionSummary?
  tasks               MentorTask[]
  supportTickets      SupportTicket[]
  ledgerEntries       LedgerEntry[]
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, startTime])
  @@index([mentorId, startTime, status])
  @@index([status, startTime])
  @@index([status, endTime])
  @@index([date])
}

model SessionNote {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  performance    Int?     // 1 to 5
  communication  Int?
  problemSolving Int?
  weakness       String?  @db.Text
  strength       String?  @db.Text
  recommendation String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SessionSummary {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  discussionTopics String?  @db.Text
  interviewTips    String?  @db.Text
  missingSkills    String?  // comma separated
  projectsToBuild  String?  @db.Text
  roadmap          String?  @db.Text // JSON or structured text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MentorTask {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title       String
  deadline    DateTime?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RescheduleRequest {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mentorId      String
  jobSeekerId   String
  oldDate       DateTime
  oldStartTime  DateTime
  requestedDate DateTime
  requestedTime DateTime 
  reason        String?
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([mentorId, status])
  @@index([jobSeekerId, status])
}

model CancellationRequest {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mentorId      String
  jobSeekerId   String
  reason        String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  refundAmount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([mentorId, status])
  @@index([jobSeekerId, status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Int           // Gross amount in INR
  platformFee       Int           @default(0) // Platform commission in INR
  mentorEarnings    Int           @default(0) // Mentor net earnings in INR
  currency          String        @default("INR")
  status            String        @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED, PARTIALLY_REFUNDED
  refundAmount      Int           @default(0)
  refundStatus      String?       // PENDING, PROCESSED, FAILED
  ledgerEntries     LedgerEntry[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
}

model LedgerEntry {
  id             String   @id @default(cuid())
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId         String?  // Payer (Job Seeker ID)
  mentorId       String?  // Payee (Mentor ID)
  type           String   // PAYMENT, REFUND, PLATFORM_FEE, MENTOR_PAYOUT
  grossAmount    Int      // Amount in INR
  platformFee    Int      @default(0)
  mentorEarnings Int      @default(0)
  currency       String   @default("INR")
  status         String   @default("COMPLETED") // PENDING, COMPLETED, FAILED, REVERSED
  description    String?
  referenceId    String?  // Razorpay Payment ID or Refund ID
  metadata       String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([bookingId])
  @@index([mentorId, createdAt])
  @@index([userId, createdAt])
  @@index([type, status])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique // Razorpay event ID (x-razorpay-event-id or payload.id)
  eventType   String    // payment.captured, payment.failed, refund.processed
  payload     String    @db.Text
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventType, processed])
}

model Notification {
  id        String   @id @default(cuid())
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  mentorId  String?
  type      String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([mentorId, type, createdAt])
}

model CalendarIntegration {
  id           String   @id @default(cuid())
  mentorId     String   @unique
  mentor       Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  provider     String
  accessToken  String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanyEmailOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Experience {
  id               String  @id @default(cuid())
  mentorId         String?
  mentor           Mentor?  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  designation      String
  duration         String
  domain           String?
  responsibilities String?
}

model Education {
  id          String   @id @default(cuid())
  mentorId    String?
  mentor      Mentor?  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree      String   // Using this as Highest qualification
  college     String
  passingYear String
  
  // New specific fields from screenshot
  branch            String?
  collegeTier       String?
  scoreType         String?
  cgpa              String?
  currentlyStudying Boolean @default(false)
  tenthMarks        String?
  tenthYear         String?
  twelfthMarks      String?
  twelfthYear       String?
  diplomaBranch     String?
  diplomaYear       String?
}

model Project {
  id           String  @id @default(cuid())
  mentorId     String?
  mentor       Mentor?  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String? @db.Text
  githubUrl    String?
  demoUrl      String?
  technologies String? // comma separated
}

model Certification {
  id       String  @id @default(cuid())
  mentorId String?
  mentor   Mentor?  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  issuer   String
  year     String?
  url      String?
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedMentor {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mentorId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  bookingId String?  @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([mentorId, rating])
  @@index([userId])
}

// --- NEW SECURITY MODELS ---
model LoginHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  country      String?
  city         String?
  status       String   // SUCCESS, FAILED, CHALLENGED
  failureReason String?
  createdAt    DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([ipAddress])
}

model DeviceFingerprint {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint  String   // Hash of OS, Browser, Res, etc.
  isTrusted    Boolean  @default(false)
  lastSeenAt   DateTime @default(now())
  
  @@unique([userId, fingerprint])
  @@index([fingerprint])
}

model SecurityEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType    String   // VPN_DETECTED, FAILED_PAYMENT, RAPID_BOOKING
  riskImpact   Int      // +10, +25, etc.
  description  String
  metadata     String?  @db.Text // Store JSON as String
  createdAt    DateTime @default(now())
  
  @@index([userId, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String   // USER_BANNED, RISK_CLEARED, VERIFIED
  targetUserId String?
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])
  previousData String?  @db.Text
  newData      String?  @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  
  @@index([adminId])
  @@index([targetUserId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  category    String
  description String   @db.Text
  attachment  String?
  status      String   @default("OPEN") // OPEN, UNDER_REVIEW, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  assignedToId String?
  assignedTo  User?    @relation("AssignedAdmin", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  messages    SupportMessage[]

  @@index([bookingId])
  @@index([userId])
  @@index([mentorId])
  @@index([assignedToId])
}

model SupportMessage {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole    String   @default("USER") // USER, ADMIN
  message       String   @db.Text
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ticketId])
  @@index([senderId])
}


model JobSeekerTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  priority    String   @default("MEDIUM")
  deadline    DateTime?
  completed   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, completed])
}

model UserDocument {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("RESUME")
  fileUrl   String
  size      Int?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  user1     User     @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user1Id, user2Id])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}
