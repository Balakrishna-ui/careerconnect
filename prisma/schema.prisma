generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums are removed for SQLite compatibility. We use String defaults.
model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?
  mobile   String? @unique
  image    String?
  role     String  @default("USER") // Using String since enums aren't natively supported in SQLite the same way, or we can use Prisma Enums (Prisma handles enum emulation in SQLite partially, actually SQLite doesn't support enums natively. Let's use String default).
  premium  Boolean @default(false)

  mentorProfile Mentor?
  adminReviews  AdminReview[]
  auditLogs     AuditLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?
  bookings      Booking[]
  subscriptions Subscription[]

  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  savedMentors  SavedMentor[]
  reviews       Review[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String   @default("PREMIUM")
  price     Int      @default(99)
  active    Boolean  @default(true)
  startDate DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mentor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public Display
  name            String
  role            String?
  company         String?
  industry        String?
  experienceYears Int?
  rating          Float     @default(0.0)
  reviewsCount    Int       @default(0)
  price           Int       @default(0)
  image           String?
  coverImage      String?
  resumeUrl       String?
  companyTier     String    @default("Other")
  location        String?
  languages       String? // comma separated list
  remoteAvailable Boolean   @default(true)
  nextAvailable   DateTime?
  totalSessions   Int       @default(0)

  // Profile Completion & Verification
  profileCompleted  Boolean @default(false)
  completionScore   Int     @default(0) // 0 to 100
  applicationStatus String  @default("DRAFT") // DRAFT, PENDING, VERIFIED, REJECTED, MORE_INFO_REQUIRED

  // Insight Metrics
  profileViews      Int     @default(0)
  searchAppearances Int     @default(0)
  profileClicks     Int     @default(0)
  responseRate      Int     @default(100)
  earningsThisMonth Int     @default(0)
  vacationMode      Boolean @default(false)

  // Step 1: Personal Info
  gender   String?
  dob      DateTime?
  country  String?
  state    String?
  city     String?
  timezone String?

  // Step 2: Professional Info
  employmentType    String?
  careerLevel       String?
  currentCTC        String?
  noticePeriod      String?
  headline          String?
  profileVisibility String  @default("PRIVATE") // PUBLIC, PRIVATE

  // Step 4: About
  bio        String?
  highlights String?

  settings        MentorSettings?
  weeklySchedules WeeklySchedule[]
  blockedDates    BlockedDate[]
  bookings        Booking[]
  calendarSync    CalendarIntegration?

  skills         Skill[]
  sessionTypes   SessionType[]
  socialProfiles SocialProfile?
  documents      VerificationDocument[]
  adminReviews   AdminReview[]

  savedMentors SavedMentor[]
  reviews      Review[]

  experiences Experience[]
  educations  Education[]
  projects       Project[]
  certifications Certification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String @id @default(cuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  name     String
  category String // Technical, Non-Technical, Areas of Mentorship
}

model SessionType {
  id       String @id @default(cuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  title    String // e.g., Resume Review
  duration Int // minutes
  price    Int // 0 if Free Discovery
}

model SocialProfile {
  id        String  @id @default(cuid())
  mentorId  String  @unique
  mentor    Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  linkedin  String
  portfolio String?
  github    String?
  twitter   String?
  youtube   String?
  website   String?
  leetcode  String?
  codechef  String?
  hackerrank String?
  behance   String?
  dribbble  String?
}

model VerificationDocument {
  id         String   @id @default(cuid())
  mentorId   String
  mentor     Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  type       String // EMPLOYEE_ID, GOVT_ID, RESUME
  fileUrl    String
  status     String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  uploadedAt DateTime @default(now())
}

model AdminReview {
  id       String @id @default(cuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  adminId  String
  admin    User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  statusGiven String
  reason      String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())
}

// Existing Models retained to avoid breaking other functionality
model MentorSettings {
  id                   String   @id @default(cuid())
  mentorId             String   @unique
  mentor               Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessionDuration      Int      @default(60)
  bufferTime           Int      @default(15)
  maxSessionsPerDay    Int      @default(5)
  advanceBookingWindow Int      @default(30)
  noticePeriod         Int      @default(24)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model WeeklySchedule {
  id          String  @id @default(cuid())
  mentorId    String
  mentor      Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)

  @@unique([mentorId, dayOfWeek])
}

model BlockedDate {
  id       String   @id @default(cuid())
  mentorId String
  mentor   Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  date     DateTime
  reason   String?

  @@unique([mentorId, date])
}

model Booking {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId      String
  mentor        Mentor         @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  status        String         @default("PENDING")
  price         Int
  meetingLink   String?
  payment       Payment?
  rescheduleReq RescheduleRequest?
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RescheduleRequest {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mentorId      String
  jobSeekerId   String
  oldDate       DateTime
  oldStartTime  DateTime
  requestedDate DateTime
  requestedTime DateTime 
  reason        String?
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  amount            Int
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  mentorId  String?
  type      String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model CalendarIntegration {
  id           String   @id @default(cuid())
  mentorId     String   @unique
  mentor       Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  provider     String
  accessToken  String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanyEmailOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Experience {
  id               String  @id @default(cuid())
  mentorId         String
  mentor           Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  companyName      String
  designation      String
  duration         String
  domain           String?
  responsibilities String?
}

model Education {
  id          String  @id @default(cuid())
  mentorId    String
  mentor      Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  college     String
  degree      String
  passingYear String
  cgpa        String?
}

model Project {
  id           String  @id @default(cuid())
  mentorId     String
  mentor       Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  title        String
  description  String? @db.Text
  githubUrl    String?
  demoUrl      String?
  technologies String? // comma separated
}

model Certification {
  id       String  @id @default(cuid())
  mentorId String
  mentor   Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  name     String
  issuer   String
  year     String?
  url      String?
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedMentor {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mentorId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  bookingId String?  @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
